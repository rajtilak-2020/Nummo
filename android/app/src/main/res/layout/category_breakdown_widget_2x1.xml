<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <!-- Left: Refined Donut Chart showing pure analytics -->
    <FrameLayout
        android:id="@+id/widget_chart_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_donut_chart"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="Spending Analytics Donut Chart"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_empty_donut" />
    </FrameLayout>

    <!-- Right: Three-Column Category Grid -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Body Area: Three-Column Category Grid or Empty State -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical">

            <!-- Three-Column Category Grid: Ultra-compact, sleek pill badges -->
            <LinearLayout
                android:id="@+id/widget_grid_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Column 1 -->
                <LinearLayout
                    android:id="@+id/widget_grid_col1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <!-- Item 1 (Row 1, Col 1) -->
                    <LinearLayout
                        android:id="@+id/widget_item_1"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/widget_chip_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/widget_item1_dot"
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_marginEnd="2.5dp"
                            android:contentDescription="Dot" />

                        <TextView
                            android:id="@+id/widget_item1_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="🏠"
                            android:textSize="9.5sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/widget_item1_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:text="46%"
                            android:textColor="#E2E8F0"
                            android:textSize="8.5sp"
                            android:singleLine="true"
                            android:textStyle="bold" />
                    </LinearLayout>

